# ============================================
# ОСНОВНЫЕ НАСТРОЙКИ БОТА
# ============================================

# Токен бота от @BotFather
# Получите его, создав бота через @BotFather в Telegram
BOT_TOKEN=ваш_токен_от_BotFather

# ID администратора (можно получить у @userinfobot)
# Это ваш Telegram ID - число, например: 123456789
ADMIN_ID=0

# ID консультанта для получения заявок (опционально)
# Если не указан, заявки будут отправляться админу
# Можно получить у @userinfobot
CONSULTANT_ID=0

# ============================================
# НАСТРОЙКИ КОМПАНИИ
# ============================================

# Название вашей компании
COMPANY_NAME=ITty Company

# Описание компании
COMPANY_DESCRIPTION=Професійні IT-консультації та рішення

# ============================================
# НАСТРОЙКИ AI-АССИСТЕНТА
# ============================================

# Включить использование AI API (true/false)
# Если false, бот будет использовать простые шаблонные ответы
USE_AI_API=false

# OpenAI API ключ (если используете OpenAI)
# Получите на https://platform.openai.com
OPENAI_API_KEY=

# DeepSeek API ключ (если используете DeepSeek)
# Получите на сайте DeepSeek
DEEPSEEK_API_KEY=

# ============================================
# НАСТРОЙКИ GOOGLE SHEETS
# ============================================

# Включить автоматическое сохранение заявок в Google Таблицу (true/false)
USE_GOOGLE_SHEETS=false

# ID Google Таблицы
# Можно получить из URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
# Где SPREADSHEET_ID - это ваш ID
GOOGLE_SHEET_ID=

# Имя листа в таблице (по умолчанию 'Заявки')
GOOGLE_SHEET_NAME=Заявки

# Путь к JSON файлу с credentials для Google API
# Скачайте из Google Cloud Console (подробнее в GOOGLE_SHEETS_SETUP.md)
GOOGLE_CREDENTIALS_FILE=credentials.json
