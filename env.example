#
# Copy this file to .env and fill values.
# Never commit .env with real secrets.
#

# Telegram BotFather token (required)
BOT_TOKEN=

# Telegram user id of admin (required for admin features)
ADMIN_ID=

# Optional: consultant who receives requests (if empty, admin receives)
CONSULTANT_ID=
CONSULTANT_USERNAME=@consultant

# Optional: company branding
COMPANY_NAME=ITty Company
COMPANY_DESCRIPTION=Професійні IT-консультації та рішення

# Optional: AI assistant
USE_AI_API=false
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional: Google Sheets integration
USE_GOOGLE_SHEETS=false
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Sheet1
# Path to service account json on server (recommended: absolute path)
GOOGLE_CREDENTIALS_FILE=credentials.json

